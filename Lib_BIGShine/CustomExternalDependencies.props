<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />

  <!-- ========================================= -->
  <!-- Common -->
  <!-- ========================================= -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
		  $(ProjectDir)Code;
		  $(ProjectDir)Shader;

		  $(ProjectDir)External\Tracy\public;

		  $(ProjectDir)External\ImGuizmo;
		  $(ProjectDir)External\imgui-docking;
		  $(ProjectDir)External\imgui-node-editor;
		  $(ProjectDir)External\imnodes-master;
		  $(ProjectDir)External\DirectXTK-main\Inc;
		  $(ProjectDir)External\DirectXTex;
		  $(ProjectDir)External\cereal-master\include;
		  $(ProjectDir)External\tinygltf-release;
		  $(ProjectDir)External\json-develop\include;
		  $(ProjectDir)External\PhisXLib\include;
		  $(ProjectDir)External\recastnavigation\DebugUtils\Include;
		  $(ProjectDir)External\recastnavigation\Detour\Include;
		  $(ProjectDir)External\recastnavigation\DetourCrowd\Include;
		  $(ProjectDir)External\recastnavigation\DetourTileCache\Include;
		  $(ProjectDir)External\recastnavigation\Recast\Include;
		  C:\Program Files\Autodesk\FBX\FBX SDK\2020.3.4\include;
		  %(AdditionalIncludeDirectories)
	  </AdditionalIncludeDirectories>
    </ClCompile>

    <Link>
      <AdditionalDependencies>
		  d3d11.lib;
		  dxgi.lib;
		  d3dcompiler.lib;
		  DirectXTK.lib;

		  ws2_32.lib;
		  dbghelp.lib;

		  PhysX_64.lib;
		  PhysXCommon_64.lib;
		  PhysXCooking_64.lib;
		  PhysXExtensions_static_64.lib;
		  PhysXFoundation_64.lib;
		  PhysXPvdSDK_static_64.lib;
		  %(AdditionalDependencies)
	  </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ========================================= -->
  <!-- x64 -->
  <!-- ========================================= -->
	<ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
		<ClCompile>
			<AdditionalIncludeDirectories>
				$(ProjectDir)External\SDL3\include;
				$(ProjectDir)External\FMOD\core\inc;
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>

		<Link>
			<AdditionalLibraryDirectories>
				$(ProjectDir)External\SDL3\lib\x64;
				$(ProjectDir)External\FMOD\core\lib\x64;
				%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>

			<AdditionalDependencies>
				SDL3.lib;
				fmod_vc.lib;
				PhysXCharacterKinematic_static_64.lib;

				ws2_32.lib;
				dbghelp.lib;

				%(AdditionalDependencies)
			</AdditionalDependencies>
		</Link>

		<PostBuildEvent>
			<Command>
				copy /Y "$(ProjectDir)External\SDL3\lib\x64\SDL3.dll" "$(OutDir)SDL3.dll"
				copy /Y "$(ProjectDir)External\FMOD\core\lib\x64\fmod.dll" "$(OutDir)fmod.dll"
				%(Command)
			</Command>
		</PostBuildEvent>
	</ItemDefinitionGroup>

  <!-- ========================================= -->
  <!-- Win32 -->
  <!-- ========================================= -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(ProjectDir)External\SDL3\include;
        $(ProjectDir)External\FMOD\core\inc;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(ProjectDir)External\SDL3\lib\x86;
        $(ProjectDir)External\FMOD\core\lib\x86;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        SDL3.lib;
        fmod_vc.lib;
        zlib-md.lib;
        libxml2-md.lib;
        libfbxsdk-md.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>
        copy /Y "$(ProjectDir)External\SDL3\lib\x86\SDL3.dll" "$(OutDir)SDL3.dll"
        copy /Y "$(ProjectDir)External\FMOD\core\lib\x86\fmod.dll" "$(OutDir)fmod.dll"
        %(Command)
      </Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- ========================================= -->
  <!-- Debug -->
  <!-- ========================================= -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' and '$(Platform)'=='x64'">
		<ClCompile>
			<PreprocessorDefinitions>
				TRACY_ENABLE;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
		</ClCompile>

		<Link>
			<AdditionalLibraryDirectories>
				$(ProjectDir)External\DirectXTK-main\Bin\Desktop_2022\x64\Debug;
				C:\Program Files\Autodesk\FBX\FBX SDK\2020.3.4\lib\vs2022\x64\debug;
				$(ProjectDir)External\PhisXLib\lib\x64\debug;
				%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>
		</Link>
	</ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' and '$(Platform)'=='Win32'">
    <Link>
      <AdditionalLibraryDirectories>
        $(VC_LibraryPath_x86);
        $(ProjectDir)External\PhisXLib\lib\x64\debug;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- ========================================= -->
  <!-- Release -->
  <!-- ========================================= -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' and '$(Platform)'=='x64'">
	  <ClCompile>
		  <PreprocessorDefinitions>
			  TRACY_ENABLE;
			  %(PreprocessorDefinitions)
		  </PreprocessorDefinitions>
	  </ClCompile>
	  
    <Link>
      <AdditionalLibraryDirectories>
        $(ProjectDir)External\DirectXTK-main\Bin\Desktop_2022\x64\Release;
        C:\Program Files\Autodesk\FBX\FBX SDK\2020.3.4\lib\vs2022\x64\release;
        $(ProjectDir)External\PhisXLib\lib\x64\release;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' and '$(Platform)'=='Win32'">
    <Link>
      <AdditionalLibraryDirectories>
        $(ProjectDir)External\PhisXLib\lib\x64\release;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- ========================================= -->
  <!-- Checked -->
  <!-- ========================================= -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='checked'">
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(ProjectDir)PhysXMatu\physx\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(ProjectDir)External\PhisXLib\lib\x64\checked;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        $(CoreLibraryDependencies);
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

	<!-- ========================================= -->
	<!-- Tracy Client -->
	<!-- ========================================= -->
	<ItemGroup Condition="'$(Platform)'=='x64'">
		<ClCompile Include="$(ProjectDir)External\Tracy\public\TracyClient.cpp" />
	</ItemGroup>

</Project>

